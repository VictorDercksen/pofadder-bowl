# Pofadder Bowl 2026 · environment
# Copy to .env.local for local development. Never commit real values.

# --- Supabase (browser-safe) -------------------------------------------------
# Project URL and the publishable (anon) key. Both are shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (server only) ---------------------------------------------------
# Secret / service-role key. Used ONLY by server-side invite + bootstrap scripts
# and the commissioner invite action. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Optional: resumable (TUS) upload endpoint. Defaults to
# ${NEXT_PUBLIC_SUPABASE_URL}/storage/v1/upload/resumable, which is correct for
# local development. Hosted projects should use the direct storage host:
# https://<project-ref>.storage.supabase.co/storage/v1/upload/resumable
NEXT_PUBLIC_SUPABASE_RESUMABLE_URL=

# --- App --------------------------------------------------------------------------
# Public origin of the deployment. Used for auth redirect links and share URLs.
# Add "<origin>/auth/confirm" to Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Slugs of the league/event this deployment serves (must match seed.sql).
NEXT_PUBLIC_LEAGUE_SLUG=show-us-your-tds
NEXT_PUBLIC_EVENT_SLUG=pofadder-bowl-2026

# Sleeper league to import members from (read-only public API, no auth).
SLEEPER_LEAGUE_ID=1313900125680054272

# --- Map tiles ----------------------------------------------------------------------
# Tile provider for the Leaflet check-in map. Attribution is rendered on the map.
# Defaults to public OpenStreetMap tiles (fine for a private league of a dozen people,
# see https://operations.osmfoundation.org/policies/tiles/). For anything busier, use
# a keyed provider:
#   MapTiler
#     NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
#     NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Set NEXT_PUBLIC_MAP_TILE_URL=static to show the labelled regional preview instead of a
# live map (check-ins are then listed, not plotted).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# --- Road routing (server only) --------------------------------------------------------
# The check-in line follows real roads: each leg between consecutive check-ins is routed
# through an OSRM server (/route/v1/driving) by /api/map-route and cached. Defaults to
# the public demo router https://router.project-osrm.org (no key, fine for a dozen
# viewers; see https://github.com/Project-OSRM/osrm-backend/wiki/Demo-server). Point it at
# a self-hosted OSRM for anything busier, or set MAP_ROUTING_URL=none for straight lines.
MAP_ROUTING_URL=

# --- Demo mode ----------------------------------------------------------------------
# /demo is always available and never writes to the backend. Set to "true" to send
# the root route to /demo when no backend is configured (e.g. a static showcase).
NEXT_PUBLIC_DEMO_ONLY=false
